# Admin: only the front controller runs; views and libraries live in app/ (denied).
Options -Indexes
DirectoryIndex index.php
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
