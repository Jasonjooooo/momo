# 云底之下: public site rules. The site is static files; PHP runs only in api/ and admin/.
Options -Indexes
DirectoryIndex index.html index.php
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# dotfiles (including temp files from atomic writes), notes, data and templates are never served
<FilesMatch "(^\.|\.(bak|orig|swp|log|lock|md|tpl\.html|json|ini|sh|sql)$)">
  Require all denied
</FilesMatch>
